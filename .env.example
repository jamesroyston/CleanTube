NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Server-only: required for passkeys (DB writes + admin.generateLink after WebAuthn). Must be the "service_role" JWT from
# Dashboard → Settings → API — not the anon / publishable key. Same Supabase project as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: public site hostname for WebAuthn rpId when it differs from the request host (e.g. apex vs www).
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_RP_NAME=CleanTube

# Server-only: official YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials).
# Used as a reliable fallback/backfill for watch metadata (description, views, date, channel
# avatar) and channel info when youtubei.js / InnerTube is bot-challenged from datacenter IPs
# (e.g. on Vercel). Inert when unset — localhost keeps its InnerTube-only behavior.
# YOUTUBE_API_KEY=your-youtube-data-api-v3-key
