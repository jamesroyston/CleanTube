{
  "name": "CleanTube",
  "short_name": "CleanTube",
  "description": "Search and watch YouTube videos with a clean, lightweight player",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#141816",
  "theme_color": "#5DD4CB",
  "scope": "/",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search YouTube videos",
      "url": "/?search=1",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Your saved library",
      "url": "/library",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Watch Later",
      "short_name": "Watch Later",
      "description": "Your watch later queue",
      "url": "/watch-later",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
