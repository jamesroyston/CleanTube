{
  "name": "CleanTube",
  "short_name": "CleanTube",
  "description": "Search and watch YouTube videos with a clean, lightweight player",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1d232a",
  "theme_color": "#605dff",
  "scope": "/",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
